# ------------------------------
# BlogNest Environment Variables
# ------------------------------

# The port your app runs on (Railway sets this automatically in production)
PORT=3100

# MongoDB connection string
# Example if using Railway MongoDB:
# mongodb://<username>:<password>@<host>:27017/<dbname>?authSource=admin
# MONGO_URI=mongodb://localhost:27017/BlogNest
MONGO_URI=mongodb+srv://ayush_gotawala_blognest:Ayush10072025@cluster91385.bczbfyj.mongodb.net/BlogNest?retryWrites=true&w=majority&appName=Cluster91385/BlogNest
# Secret for signing sessions/cookies (use a long random string)
SESSION_SECRET=your_super_secret_key

# Set environment mode
NODE_ENV=development
